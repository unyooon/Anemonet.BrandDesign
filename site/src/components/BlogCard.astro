---
/**
 * @description ブログ記事カードコンポーネント
 * - 記事一覧ページで使用するカード形式のリンクコンポーネント
 */

type Props = {
  /** 記事タイトル */
  title: string;
  /** 記事の説明文 */
  description: string;
  /** 公開日 */
  publishedAt: Date;
  /** タグ一覧 */
  tags: string[];
  /** 記事の slug（URL の一部） */
  slug: string;
};

const { title, description, publishedAt, tags, slug } = Astro.props;

/**
 * @description Date を "YYYY年MM月DD日" 形式にフォーマットする
 * @param date - フォーマットする日付
 * @returns フォーマットされた日付文字列
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
}

/**
 * @description Date を ISO 8601 形式の文字列に変換する
 * @param date - 変換する日付
 * @returns ISO 8601 形式の文字列
 */
function toISOString(date: Date): string {
  return date.toISOString();
}
---

<a href={`/blog/${slug}/`} class="blog-card">
  {tags.length > 0 && (
    <div class="blog-card-tags">
      {tags.map(tag => (
        <span class="tag-badge">{tag}</span>
      ))}
    </div>
  )}

  <h2 class="blog-card-title">{title}</h2>
  <p class="blog-card-description">{description}</p>

  <div class="blog-card-footer">
    <div class="blog-meta">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <time datetime={toISOString(publishedAt)}>
        {formatDate(publishedAt)}
      </time>
    </div>
  </div>
</a>
