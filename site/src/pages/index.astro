---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Anemonet",
  "url": "https://anemonet.dev",
  "description": "Anemonet は変化の風を読み取り、生成AI駆動開発で顧客が本当に必要とするシステムを構築します。",
  "slogan": "風を読み、本質を咲かせる。",
  "knowsAbout": ["AI駆動開発", "Claude Code", "システム開発", "Web開発"],
  "areaServed": {
    "@type": "Country",
    "name": "JP"
  },
  "serviceType": ["AI駆動開発", "Claude Code開発基盤構築"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "サービス一覧",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI駆動開発",
          "description": "動くシステムを起点に対話を重ね、顧客が本当に必要とする要件を導き出し、最適なアーキテクチャで構築する"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Claude Code開発基盤構築",
          "description": "開発アーキテクチャに合わせたCLAUDE.md・カスタムコマンド・Lint等のClaude Code開発基盤を整備し、開発効率向上を支援"
        }
      }
    ]
  }
};
---

<BaseLayout
  title="Anemonet — 風を読み、本質を咲かせる。"
  description="AI駆動開発で「本当に必要なシステム」を高速に実現。Claude Code 開発基盤構築にも対応。まずはお気軽にご相談ください。"
  canonicalUrl="https://anemonet.dev/"
  ogType="website"
  jsonLd={jsonLd}
>
  <Header currentPath="/" />

  <!-- SVG フィルター定義（有機的ノイズ変形） -->
  <svg class="svg-filters" aria-hidden="true" style="position:absolute;width:0;height:0">
    <defs>
      <filter id="organic-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="60" />
      </filter>
    </defs>
  </svg>

  <main class="site-main" id="main-content">
    <!-- 有機的 blob 背景（花びらが散るような表現） -->
    <div class="organic-blobs" aria-hidden="true">
      <div class="organic-blob ob-1"></div>
      <div class="organic-blob ob-2"></div>
      <div class="organic-blob ob-3"></div>
      <div class="organic-blob ob-4"></div>
      <div class="organic-blob ob-5"></div>
      <div class="organic-blob ob-6"></div>
      <div class="organic-blob ob-7"></div>
      <div class="organic-blob ob-8"></div>
    </div>

    <!-- Hero -->
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="container">
        <p class="hero-eyebrow">Anemonet</p>
        <h1 id="hero-heading" class="hero-title">風を読み、本質を咲かせる。</h1>
        <p class="hero-sub">AI駆動のシステム開発パートナー — Anemonet</p>
        <p class="hero-lead">
          変化の時代に、あなたが本当に必要とするシステムを。
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary btn-lg">お問い合わせ</a>
          <a href="#services" class="btn btn-outline btn-lg">サービスを見る</a>
        </div>
      </div>
    </section>

    <!-- Philosophy -->
    <section id="philosophy" class="site-section brand-section philosophy-section section-alt" aria-labelledby="philosophy-heading">
      <div class="container">
        <div class="brand-inner">
          <div class="brand-text">
            <p class="section-eyebrow">Philosophy</p>
            <h2 id="philosophy-heading" class="brand-heading">Anemonet とは</h2>
            <p class="brand-desc">
              アネモネは「風の花」。ギリシャ語で風を意味する Anemos を語源に持ち、
              早春の風が吹くといち早く花を開きます。
            </p>
            <p class="brand-desc">
              Anemonet は、その名の通り、変化の風を読み取り、いち早く動きます。
            </p>
            <p class="brand-desc">
              顧客が本当に必要としているものは、最初から明確とは限りません。
              アネモネの花びらに見える部分が実は「がく」であるように、
              表面の要件の奥には、まだ言葉になっていない本質があります。
            </p>
            <p class="brand-desc">
              私たちは、動くシステムを起点に対話を重ね、つくっては壊し、
              その本質に辿り着きます。
            </p>
            <p class="brand-desc">
              そしてアネモネの種が風に乗って広がるように、
              一つのプロジェクトで得た知見を次へとつなぎ、
              関わるすべての人に価値を届けます。
            </p>
          </div>

          <div class="brand-visual" aria-hidden="true">
            <img src="/logo-icon.png" alt="" class="brand-logo-img" width="240" height="240" />
          </div>
        </div>

        <!-- Mission & Vision -->
        <div class="mv-grid" role="list">
          <div class="mv-card" role="listitem">
            <span class="mv-label">Mission</span>
            <p class="mv-quote">「風を読み、本質を咲かせる。」</p>
            <p class="mv-desc">
              変化の激しいシステム開発の世界で、時代の風を読み続け、顧客が言葉にできていない本当のニーズを引き出し、最適な形で実現する。
            </p>
          </div>
          <div class="mv-card" role="listitem">
            <span class="mv-label">Vision</span>
            <p class="mv-quote">「技術と人をつなぎ、知見が循環するネットワークの中心であり続ける。」</p>
            <p class="mv-desc">
              アネモネの種が風に乗って広がるように、プロジェクトを通じて得た知見を蓄積・循環させ、関わるすべての人に価値を届ける。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section id="values" class="site-section values-section" aria-labelledby="values-heading">
      <div class="container">
        <p class="section-eyebrow">Values</p>
        <h2 id="values-heading" class="section-heading">行動指針</h2>

        <div class="values-grid" role="list">

          <!-- 1. Wind Reading -->
          <div class="value-card" role="listitem">
            <div class="value-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>
              </svg>
            </div>
            <p class="value-name-en">Wind Reading</p>
            <p class="value-name-ja">風を読む</p>
            <p class="value-desc">技術の潮流を常に捉え、手法を更新し続ける</p>
          </div>

          <!-- 2. Root Finding -->
          <div class="value-card" role="listitem">
            <div class="value-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </div>
            <p class="value-name-en">Root Finding</p>
            <p class="value-name-ja">根を見つける</p>
            <p class="value-desc">表面の要件ではなく、潜在的な課題の根に辿り着く</p>
          </div>

          <!-- 3. Rebuild Courage -->
          <div class="value-card" role="listitem">
            <div class="value-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"/>
                <polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
            </div>
            <p class="value-name-en">Rebuild Courage</p>
            <p class="value-name-ja">壊す勇気</p>
            <p class="value-desc">うまくいかなければ壊して学び、より良く作り直す</p>
          </div>

          <!-- 4. Grow Together -->
          <div class="value-card" role="listitem">
            <div class="value-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <p class="value-name-en">Grow Together</p>
            <p class="value-name-ja">共に咲く</p>
            <p class="value-desc">外注先ではなく、同じチームの一員として伴走する</p>
          </div>

          <!-- 5. Spread Seeds -->
          <div class="value-card" role="listitem">
            <div class="value-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </div>
            <p class="value-name-en">Spread Seeds</p>
            <p class="value-name-ja">種を蒔く</p>
            <p class="value-desc">得た知見をネットワークに還元し、共有する</p>
          </div>

        </div>
      </div>
    </section>

    <!-- About Us -->
    <section id="about" class="site-section about-section section-alt" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-inner">
          <div class="about-text">
            <p class="section-eyebrow">About Me</p>
            <h2 id="about-heading" class="about-name">
              山川 祐汰
              <span class="about-name-roman">Yuta Yamakawa</span>
            </h2>
            <p class="about-role">Software Engineer</p>
            <p class="about-bio">動くものを見せながら一緒に考える、が基本スタイル。AI駆動開発でスピードと品質を両立します。</p>
            <div class="about-skills" role="list" aria-label="スキルセット">
              <span class="skill-badge" role="listitem">TypeScript / Node.js</span>
              <span class="skill-badge" role="listitem">C# / .NET</span>
              <span class="skill-badge" role="listitem">Python</span>
              <span class="skill-badge" role="listitem">Vue.js / Nuxt</span>
              <span class="skill-badge" role="listitem">React</span>
              <span class="skill-badge" role="listitem">AWS / Azure / Firebase</span>
              <span class="skill-badge" role="listitem">Claude / ChatGPT / Gemini</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="site-section" aria-labelledby="services-heading">
      <div class="container">
        <p class="section-eyebrow">Services</p>
        <h2 id="services-heading" class="section-heading">サービス</h2>
        <p class="section-lead">
          変化の風を読み、最適な技術と手法で、あなたのシステムを構築します。
        </p>

        <!-- Service 1: AI駆動開発 -->
        <article class="service-block" aria-labelledby="service1-heading">
          <div class="service-block-header">
            <div class="service-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <div>
              <h3 id="service1-heading" class="service-title">AI駆動開発</h3>
              <p class="service-subtitle">Iterative Prototyping with AI</p>
            </div>
          </div>
          <p class="service-desc">
            仕様書を書き上げてから開発する従来型では、完成後に「思っていたものと違う」が起きがちです。かといって要件が曖昧なままAIで高速に作り続ければ、コードは膨れ運用コストだけが増えていく。
          </p>
          <p class="service-desc">
            Anemonetの提案するAI駆動開発は「作っては壊す」が前提。プロトタイプで要件の本質を見極めてから、本番品質で構築し直す。速さと堅牢さを両立します。
          </p>

          <div class="process-flow" role="list" aria-label="開発プロセス">
            <div class="process-step" role="listitem">
              <div class="process-step-header">
                <span class="step-number" aria-label="ステップ1">1</span>
                <h4 class="step-title">作って見せる</h4>
              </div>
              <p class="step-text">AIで動くプロトタイプを即座に構築し、画面を見ながら一緒に方向性を決める。</p>
            </div>
            <div class="process-connector" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>
            <div class="process-step" role="listitem">
              <div class="process-step-header">
                <span class="step-number" aria-label="ステップ2">2</span>
                <h4 class="step-title">壊して学ぶ</h4>
              </div>
              <p class="step-text">得た知見をもとにゼロから再設計。負債を持ち越さない。</p>
            </div>
            <div class="process-connector" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>
            <div class="process-step" role="listitem">
              <div class="process-step-header">
                <span class="step-number" aria-label="ステップ3">3</span>
                <h4 class="step-title">本番品質で仕上げる</h4>
              </div>
              <p class="step-text">要件が固まった段階で、堅牢なアーキテクチャで本開発。</p>
            </div>
          </div>

          <div class="process-cycle-note" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            <span>1〜2 を高速に反復し、要件の本質を見極める</span>
          </div>

          <div class="service-highlights">
            <div class="service-highlight">
              <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <p>設計・開発から運用保守まで一気通貫で対応</p>
            </div>
            <div class="service-highlight">
              <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <p>生成AIによる圧倒的なスピードで仮説検証のサイクルを短縮</p>
            </div>
          </div>
        </article>

        <!-- Service 2: Claude Code 開発基盤構築 -->
        <article class="service-block" aria-labelledby="service2-heading">
          <div class="service-block-header">
            <div class="service-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
            </div>
            <div>
              <h3 id="service2-heading" class="service-title">Claude Code 開発基盤構築</h3>
              <p class="service-subtitle">AI-Assisted Development Infrastructure</p>
            </div>
          </div>
          <p class="service-desc">
            Claude Code の導入を検討している開発チーム向けに、プロジェクトの技術スタックに最適化された開発基盤を設計・構築します。
            ツールを入れるだけでは得られない、チーム全体の開発生産性を引き上げる仕組みを整えます。
          </p>

          <div class="deliverables-grid">
            <div class="deliverable">
              <h4 class="deliverable-title">
                <svg class="deliverable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                CLAUDE.md 設計
              </h4>
              <p class="deliverable-desc">プロジェクトのアーキテクチャ・コーディング規約・ワークフローに沿った指示書を構築。AI が一貫した品質でコードを生成する土台を整備します。</p>
            </div>
            <div class="deliverable">
              <h4 class="deliverable-title">
                <svg class="deliverable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                カスタムコマンド・Lint 整備
              </h4>
              <p class="deliverable-desc">チーム固有のタスクを自動化するカスタムコマンド群と、AI 生成コードの品質を担保する Lint ルールを設計・実装します。</p>
            </div>
            <div class="deliverable">
              <h4 class="deliverable-title">
                <svg class="deliverable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                運用フロー最適化
              </h4>
              <p class="deliverable-desc">コードレビュー・テスト・デプロイを含む開発サイクル全体に Claude Code を組み込み、チームの開発体験を向上させます。</p>
            </div>
          </div>

          <div class="service-highlights">
            <div class="service-highlight">
              <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <p>新規プロジェクトはもちろん、既存システムへの段階的な導入にも対応</p>
            </div>
            <div class="service-highlight">
              <svg class="highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <p>技術スタック・チーム規模に合わせたテーラーメイドの基盤を構築</p>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="site-section contact-section section-alt" aria-labelledby="contact-heading">
      <div class="container">
        <p class="section-eyebrow">Contact</p>
        <h2 id="contact-heading" class="section-heading">お問い合わせ</h2>
        <p class="contact-intro">
          ご相談・ご質問など、お気軽にお問い合わせください。
        </p>
        <div class="contact-actions">
          <a
            href="https://docs.google.com/forms/d/18o60bJoYsvb_LqFg0l-HZ3Oou5Lha6e6w1b2m5nHmwU/viewform"
            class="btn btn-primary btn-lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            お問い合わせフォームを開く
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style is:global>
/* ============================================================
   Hero Section
   ============================================================ */
.hero-section {
  background: transparent;
  padding: 80px 0;
  position: relative;
}

.hero-section .container {
  position: relative;
  z-index: 1;
}

.hero-section > .container {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.hero-eyebrow {
  font-size: var(--anm-text-small-size);
  font-weight: var(--anm-font-weight-semibold);
  color: var(--anm-color-accent-main);
  text-transform: uppercase;
