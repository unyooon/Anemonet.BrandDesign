<script>
document.querySelectorAll<HTMLElement>(".swatch-card[data-copy]").forEach(card => {
  card.addEventListener("click", () => {
    const text = card.dataset.copy;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      const existing = document.getElementById("copy-toast");
      if (existing) existing.remove();
      const toast = document.createElement("div");
      toast.id = "copy-toast";
      toast.textContent = `コピーしました: ${text}`;
      toast.style.cssText = `
        position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
        background-color: var(--anm-color-neutral-900); color: var(--anm-color-neutral-50);
        font-size: 14px; padding: 8px 20px; border-radius: 9999px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2); z-index: 9999; pointer-events: none;
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    });
  });
});
</script>
