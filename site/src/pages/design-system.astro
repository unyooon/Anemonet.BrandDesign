<style is:global>
/* docs.css からページ固有スタイルを抽出 */
.site-main {
  padding: var(--anm-space-16) 0;
}

.section-card {
  background-color: var(--anm-color-bg-card);
  border: 1px solid var(--anm-color-border-subtle);
  border-radius: var(--anm-radius-xl);
  padding: var(--anm-space-10);
  margin-bottom: var(--anm-space-8);
  box-shadow: var(--anm-shadow-sm);
  transition:
    background-color var(--anm-transition-duration-slow) var(--anm-transition-easing-default),
    border-color var(--anm-transition-duration-slow) var(--anm-transition-easing-default);
}

.section-title {
  font-size: var(--anm-text-h2-size);
  font-weight: var(--anm-font-weight-semibold);
  line-height: var(--anm-text-h2-line-height);
  color: var(--anm-color-text-heading);
  margin-bottom: var(--anm-space-6);
  padding-bottom: var(--anm-space-4);
  border-bottom: 2px solid var(--anm-color-action-primary-default);
  display: inline-block;
}

.subsection-title {
  font-size: var(--anm-text-h3-size);
  font-weight: var(--anm-font-weight-semibold);
  line-height: var(--anm-text-h3-line-height);
  color: var(--anm-color-text-heading);
  margin-top: var(--anm-space-8);
  margin-bottom: var(--anm-space-4);
}

.subsection-title:first-child { margin-top: 0; }

.hero-section {
  background: linear-gradient(135deg, var(--anm-color-primary-50) 0%, var(--anm-color-bg-card) 60%, var(--anm-color-accent-tint) 100%);
  border: 1px solid var(--anm-color-border-subtle);
  border-radius: var(--anm-radius-xl);
  padding: var(--anm-space-16) var(--anm-space-10);
  margin-bottom: var(--anm-space-8);
  position: relative;
  overflow: hidden;
}

[data-theme="dark"] .hero-section {
  background: linear-gradient(135deg, var(--anm-color-primary-950) 0%, var(--anm-color-bg-card) 60%, rgba(192, 56, 138, 0.12) 100%);
}

.hero-eyebrow {
  font-size: var(--anm-text-small-size);
  font-weight: var(--anm-font-weight-semibold);
  color: var(--anm-color-accent-main);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: var(--anm-space-3);
}

.hero-title {
