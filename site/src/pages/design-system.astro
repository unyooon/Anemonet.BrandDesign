---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "name": "Anemonet Design System",
  "url": "https://anemonet.dev/design-system",
  "description": "Anemonet ブランドデザインシステム — デザイントークン、タイポグラフィ、カラー、コンポーネントのガイドライン",
  "author": {
    "@type": "Organization",
    "name": "Anemonet",
    "url": "https://anemonet.dev"
  }
};
---

<BaseLayout
  title="Anemonet Design System"
  description="Anemonet ブランドデザインシステム — デザイントークン、タイポグラフィ、カラー、コンポーネントのガイドライン。CSS Custom Properties を中核に、Tailwind・shadcn/ui 等へのアドオンも提供。"
  canonicalUrl="https://anemonet.dev/design-system"
  ogType="website"
  jsonLd={jsonLd}
>
  <Header currentPath="/design-system" />

  <main class="site-main" id="main-content">
    <div class="container">

      <!-- Brand Story -->
      <section class="hero-section" aria-labelledby="brand-story-heading">
        <p class="hero-eyebrow">Brand Identity</p>
        <h1 id="brand-story-heading" class="hero-title">Anemonet</h1>
        <p class="hero-story">
          アネモネは、早春にいち早く咲く。まだ冬の名残が残る大地に、鮮やかな色彩で存在を示す。
          Anemonet は、その姿に倣う。複雑さの中に明確な美しさを見出し、精密さの中に有機的な温かみを宿す。
          システム開発という論理の世界に、花が咲くような体験をもたらすために。
        </p>
        <div class="hero-tone" role="note">
          <span class="hero-tone-dot" aria-hidden="true"></span>
          Elegant Modern &mdash; &ldquo;Organic Precision&rdquo;（有機的精密さ）
        </div>
      </section>

      <!-- Colors -->
      <section class="section-card" id="colors" aria-labelledby="colors-heading">
        <h2 id="colors-heading" class="section-title">Colors</h2>

        <h3 class="subsection-title">Primary</h3>
        <div class="swatch-grid" role="list">
          <div class="swatch-card" role="listitem" data-copy="#f5f2fd" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-50);" aria-label="Primary 50"></div>
            <div class="swatch-info">
              <span class="swatch-label">50</span>
              <span class="swatch-hex">#f5f2fd</span>
              <span class="swatch-var">--anm-color-primary-50</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#ebe5fb" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-100);"></div>
            <div class="swatch-info">
              <span class="swatch-label">100</span>
              <span class="swatch-hex">#ebe5fb</span>
              <span class="swatch-var">--anm-color-primary-100</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#d5c8f7" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-200);"></div>
            <div class="swatch-info">
              <span class="swatch-label">200</span>
              <span class="swatch-hex">#d5c8f7</span>
              <span class="swatch-var">--anm-color-primary-200</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#b9a0ee" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-300);"></div>
            <div class="swatch-info">
              <span class="swatch-label">300</span>
              <span class="swatch-hex">#b9a0ee</span>
              <span class="swatch-var">--anm-color-primary-300</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#9472e2" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-400);"></div>
            <div class="swatch-info">
              <span class="swatch-label">400</span>
              <span class="swatch-hex">#9472e2</span>
              <span class="swatch-var">--anm-color-primary-400</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#7650d3" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-500);"></div>
            <div class="swatch-info">
              <span class="swatch-label">500</span>
              <span class="swatch-hex">#7650d3</span>
              <span class="swatch-var">--anm-color-primary-500</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#5c38c0" title="クリックでコピー" style="outline: 2px solid var(--anm-color-primary-600); outline-offset: 2px; border-radius: var(--anm-radius-lg);">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-600);"></div>
            <div class="swatch-info">
              <span class="swatch-label" style="color: var(--anm-color-action-primary-default);">600 ★ Default</span>
              <span class="swatch-hex">#5c38c0</span>
              <span class="swatch-var">--anm-color-primary-600</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#4b2da5" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-700);"></div>
            <div class="swatch-info">
              <span class="swatch-label">700</span>
              <span class="swatch-hex">#4b2da5</span>
              <span class="swatch-var">--anm-color-primary-700</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#3c238a" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-800);"></div>
            <div class="swatch-info">
              <span class="swatch-label">800</span>
              <span class="swatch-hex">#3c238a</span>
              <span class="swatch-var">--anm-color-primary-800</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#2d1a6e" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-900);"></div>
            <div class="swatch-info">
              <span class="swatch-label">900</span>
              <span class="swatch-hex">#2d1a6e</span>
              <span class="swatch-var">--anm-color-primary-900</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#1a0e42" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-primary-950);"></div>
            <div class="swatch-info">
              <span class="swatch-label">950</span>
              <span class="swatch-hex">#1a0e42</span>
              <span class="swatch-var">--anm-color-primary-950</span>
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Neutral</h3>
        <div class="swatch-grid" role="list">
          <div class="swatch-card" role="listitem" data-copy="#f8f7fc" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-50); border-bottom: 1px solid var(--anm-color-border-subtle);"></div>
            <div class="swatch-info">
              <span class="swatch-label">50</span>
              <span class="swatch-hex">#f8f7fc</span>
              <span class="swatch-var">--anm-color-neutral-50</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#f0eef8" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-100);"></div>
            <div class="swatch-info">
              <span class="swatch-label">100</span>
              <span class="swatch-hex">#f0eef8</span>
              <span class="swatch-var">--anm-color-neutral-100</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#e2dff1" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-200);"></div>
            <div class="swatch-info">
              <span class="swatch-label">200</span>
              <span class="swatch-hex">#e2dff1</span>
              <span class="swatch-var">--anm-color-neutral-200</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#c9c4df" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-300);"></div>
            <div class="swatch-info">
              <span class="swatch-label">300</span>
              <span class="swatch-hex">#c9c4df</span>
              <span class="swatch-var">--anm-color-neutral-300</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#a9a2c7" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-400);"></div>
            <div class="swatch-info">
              <span class="swatch-label">400</span>
              <span class="swatch-hex">#a9a2c7</span>
              <span class="swatch-var">--anm-color-neutral-400</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#8a82ab" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-500);"></div>
            <div class="swatch-info">
              <span class="swatch-label">500</span>
              <span class="swatch-hex">#8a82ab</span>
              <span class="swatch-var">--anm-color-neutral-500</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#6c648e" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-600);"></div>
            <div class="swatch-info">
              <span class="swatch-label">600</span>
              <span class="swatch-hex">#6c648e</span>
              <span class="swatch-var">--anm-color-neutral-600</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#524d72" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-700);"></div>
            <div class="swatch-info">
              <span class="swatch-label">700</span>
              <span class="swatch-hex">#524d72</span>
              <span class="swatch-var">--anm-color-neutral-700</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#3a3557" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-800);"></div>
            <div class="swatch-info">
              <span class="swatch-label">800</span>
              <span class="swatch-hex">#3a3557</span>
              <span class="swatch-var">--anm-color-neutral-800</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#242040" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-900);"></div>
            <div class="swatch-info">
              <span class="swatch-label">900</span>
              <span class="swatch-hex">#242040</span>
              <span class="swatch-var">--anm-color-neutral-900</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#141029" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-neutral-950);"></div>
            <div class="swatch-info">
              <span class="swatch-label">950</span>
              <span class="swatch-hex">#141029</span>
              <span class="swatch-var">--anm-color-neutral-950</span>
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Status Colors</h3>
        <div class="status-grid" role="list">
          <div class="status-swatch" role="listitem">
            <div class="status-swatch-main" style="background-color: var(--anm-color-error-main);"><span class="status-swatch-main-label">Error</span></div>
            <div class="status-swatch-bg" style="background-color: var(--anm-color-error-light-bg);"></div>
            <div class="status-swatch-info">
              <span class="status-label">Error</span>
              <span class="swatch-hex">#dc2626</span>
              <span class="swatch-var">--anm-color-error-main</span>
            </div>
          </div>
          <div class="status-swatch" role="listitem">
            <div class="status-swatch-main" style="background-color: var(--anm-color-warning-main);"><span class="status-swatch-main-label">Warning</span></div>
            <div class="status-swatch-bg" style="background-color: var(--anm-color-warning-light-bg);"></div>
            <div class="status-swatch-info">
              <span class="status-label">Warning</span>
              <span class="swatch-hex">#d97706</span>
              <span class="swatch-var">--anm-color-warning-main</span>
            </div>
          </div>
          <div class="status-swatch" role="listitem">
            <div class="status-swatch-main" style="background-color: var(--anm-color-success-main);"><span class="status-swatch-main-label">Success</span></div>
            <div class="status-swatch-bg" style="background-color: var(--anm-color-success-light-bg);"></div>
            <div class="status-swatch-info">
              <span class="status-label">Success</span>
              <span class="swatch-hex">#16a34a</span>
              <span class="swatch-var">--anm-color-success-main</span>
            </div>
          </div>
          <div class="status-swatch" role="listitem">
            <div class="status-swatch-main" style="background-color: var(--anm-color-info-main);"><span class="status-swatch-main-label">Info</span></div>
            <div class="status-swatch-bg" style="background-color: var(--anm-color-info-light-bg);"></div>
            <div class="status-swatch-info">
              <span class="status-label">Info</span>
              <span class="swatch-hex">#0891b2</span>
              <span class="swatch-var">--anm-color-info-main</span>
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Accent — Anemone Pink</h3>
        <div class="swatch-grid swatch-grid-2" role="list" style="max-width: 320px;">
          <div class="swatch-card" role="listitem" data-copy="#c0388a" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-accent-main); height: 80px;"></div>
            <div class="swatch-info">
              <span class="swatch-label">Main</span>
              <span class="swatch-hex">#c0388a</span>
              <span class="swatch-var">--anm-color-accent-main</span>
            </div>
          </div>
          <div class="swatch-card" role="listitem" data-copy="#f5d0e8" title="クリックでコピー">
            <div class="swatch-color" style="background-color: var(--anm-color-accent-tint); height: 80px;"></div>
            <div class="swatch-info">
              <span class="swatch-label">Tint</span>
              <span class="swatch-hex">#f5d0e8</span>
              <span class="swatch-var">--anm-color-accent-tint</span>
            </div>
          </div>
        </div>

        <h3 class="subsection-title">Semantic Colors</h3>
        <div class="semantic-grid" role="list">
          <div>
            <p class="semantic-group-title" style="grid-column: auto;">Text</p>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <div class="swatch-card" role="listitem" data-copy="#1c1529" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-text-heading); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Heading</span><span class="swatch-var">--anm-color-text-heading</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#3e3455" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-text-body); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Body</span><span class="swatch-var">--anm-color-text-body</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#7a6f93" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-text-sub); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Sub</span><span class="swatch-var">--anm-color-text-sub</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#b8b2cc" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-text-disabled); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Disabled</span><span class="swatch-var">--anm-color-text-disabled</span></div>
              </div>
            </div>
          </div>
          <div>
            <p class="semantic-group-title" style="grid-column: auto;">Background</p>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <div class="swatch-card" role="listitem" data-copy="#f8f7fd" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-bg-page); border: 1px solid var(--anm-color-border-subtle); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Page</span><span class="swatch-var">--anm-color-bg-page</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#ffffff" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-bg-card); border: 1px solid var(--anm-color-border-subtle); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Card</span><span class="swatch-var">--anm-color-bg-card</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#f0ecf8" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-bg-section); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Section</span><span class="swatch-var">--anm-color-bg-section</span></div>
              </div>
            </div>
          </div>
          <div>
            <p class="semantic-group-title" style="grid-column: auto;">Border</p>
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <div class="swatch-card" role="listitem" data-copy="#e2dcf0" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-border-default); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Default</span><span class="swatch-var">--anm-color-border-default</span></div>
              </div>
              <div class="swatch-card" role="listitem" data-copy="#ede9f5" title="クリックでコピー" style="display: flex; align-items: center; gap: 12px; padding: 10px 12px;">
                <div style="width: 32px; height: 32px; border-radius: var(--anm-radius-sm); background-color: var(--anm-color-border-subtle); border: 1px solid var(--anm-color-border-default); flex-shrink: 0;"></div>
                <div><span class="swatch-label" style="display:block;">Subtle</span><span class="swatch-var">--anm-color-border-subtle</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Typography -->
      <section class="section-card" id="typography" aria-labelledby="typography-heading">
        <h2 id="typography-heading" class="section-title">Typography</h2>

        <h3 class="subsection-title">Type Scale</h3>
        <div class="type-scale-list" role="list">
          <div class="type-scale-item" role="listitem">
            <div class="type-scale-preview" style="font-size: var(--anm-text-display-size); font-weight: var(--anm-text-display-weight); line-height: var(--anm-text-display-line-height);">Display — 表示見出し</div>
            <div class="type-scale-meta">
              <span class="type-meta-name">Display</span>
              <span class="type-meta-spec">36px · 700 · lh 1.20</span>
              <span class="type-meta-usage">ヒーロー、スプラッシュ</span>
            </div>
          </div>
          <div class="type-scale-item" role="listitem">
            <div class="type-scale-preview" style="font-size: var(--anm-text-h1-size); font-weight: var(--anm-text-h1-weight); line-height: var(--anm-text-h1-line-height);">H1 — ページタイトル</div>
            <div class="type-scale-meta">
              <span class="type-meta-name">H1</span>
              <span class="type-meta-spec">30px · 700 · lh 1.25</span>
              <span class="type-meta-usage">ページ見出し</span>
            </div>
          </div>
          <div class="type-scale-item" role="listitem">
            <div class="type-scale-preview" style="font-size: var(--anm-text-h2-size); font-weight: var(--anm-text-h2-weight); line-height: var(--anm-text-h2-line-height);">H2 — セクション見出し</div>
            <div class="type-scale-meta">
              <span class="type-meta-name">H2</span>
              <span class="type-meta-spec">24px · 600 · lh 1.30</span>
              <span class="type-meta-usage">セクション区切り</span>
            </div>
          </div>
          <div class="type-scale-item" role="listitem">
            <div class="type-scale-preview" style="font-size: var(--anm-text-h3-size); font-weight: var(--anm-text-h3-weight); line-height: var(--anm-text-h3-line-height);">H3 — サブセクション見出し</div>
