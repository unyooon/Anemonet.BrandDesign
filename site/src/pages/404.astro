---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="ページが見つかりません | Anemonet"
  description="お探しのページが見つかりませんでした。"
  noindex={true}
  ogType="website"
>
  <!-- 簡素なヘッダー（ナビなし、テーマトグルのみ） -->
  <header class="site-header" role="banner">
    <div class="container">
      <a href="/" class="site-logo" aria-label="Anemonet トップへ">
        <span class="logo-name">Anemonet</span>
      </a>

      <div class="header-controls">
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="ダークモードに切替"
          data-theme-current="light"
        >
          <svg class="theme-icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="theme-icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="site-main error-page" id="main-content">
    <div class="container">
      <div class="error-content">
        <p class="error-code" aria-label="エラーコード 404">404</p>
        <h1 class="error-message">お探しのページが見つかりませんでした</h1>
        <p class="error-description">
          ページが移動または削除された可能性があります。
        </p>
        <a href="/" class="btn btn-primary btn-md">トップページへ戻る</a>
      </div>
    </div>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div class="footer-inner">
        <div>
          <span class="footer-brand">Anemonet</span>
          <p class="footer-meta">&copy; 2026 Anemonet. All rights reserved.</p>
        </div>
        <nav class="footer-links" aria-label="フッターナビゲーション">
        </nav>
      </div>
    </div>
  </footer>
</BaseLayout>

<style is:global>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--anm-color-bg-card);
  border-bottom: 1px solid var(--anm-color-border-subtle);
  box-shadow: var(--anm-shadow-sm);
}

.site-header .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
  gap: var(--anm-space-4);
}

.site-logo {
  display: flex;
  align-items: center;
  gap: var(--anm-space-2);
  text-decoration: none;
  flex-shrink: 0;
}

.site-logo:hover { text-decoration: none; }

.logo-name {
  font-size: var(--anm-text-h3-size);
  font-weight: var(--anm-font-weight-bold);
  color: var(--anm-color-action-primary-default);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.header-controls {
  display: flex;
  align-items: center;
  gap: var(--anm-space-2);
  flex-shrink: 0;
}

.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1px solid var(--anm-color-border-default);
  border-radius: var(--anm-radius-full);
  background: transparent;
  cursor: pointer;
  color: var(--anm-color-text-sub);
}

.theme-toggle:hover {
  background-color: var(--anm-color-action-primary-subtle);
  border-color: var(--anm-color-action-primary-default);
  color: var(--anm-color-action-primary-default);
}

.theme-toggle:focus-visible {
  outline: 2px solid var(--anm-color-action-primary-default);
  outline-offset: 2px;
}

.theme-icon { width: 20px; height: 20px; }
.icon-sun { display: none; }
.icon-moon { display: block; }
[data-theme="dark"] .icon-sun { display: block; }
[data-theme="dark"] .icon-moon { display: none; }

.site-main {
  padding-bottom: var(--anm-space-16);
  background: var(--anm-color-bg-page);
}

.error-page {
  display: flex;
  align-items: center;
  min-height: calc(100vh - 64px - 80px);
  padding: var(--anm-space-16) 0;
}

.error-content {
  text-align: center;
  max-width: 480px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--anm-space-4);
}

.error-code {
  font-size: clamp(80px, 20vw, 160px);
  font-weight: var(--anm-font-weight-bold);
  line-height: 1;
  color: var(--anm-color-action-primary-default);
  letter-spacing: -0.04em;
}

.error-message {
  font-size: var(--anm-text-h2-size);
  font-weight: var(--anm-font-weight-semibold);
  line-height: var(--anm-text-h2-line-height);
  color: var(--anm-color-text-heading);
  letter-spacing: -0.02em;
}

.error-description {
  font-size: var(--anm-text-base-size);
  line-height: var(--anm-text-base-line-height);
  color: var(--anm-color-text-sub);
}

.site-footer {
  border-top: 1px solid var(--anm-color-border-subtle);
  padding: var(--anm-space-8) 0;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--anm-space-4);
}

.footer-brand {
  font-weight: var(--anm-font-weight-semibold);
  color: var(--anm-color-action-primary-default);
}

.footer-meta {
  font-size: var(--anm-text-small-size);
  color: var(--anm-color-text-sub);
}

.footer-links {
  display: flex;
  gap: var(--anm-space-4);
}
</style>
