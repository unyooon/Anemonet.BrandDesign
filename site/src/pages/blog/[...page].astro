---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import Pagination from "../../components/Pagination.astro";
import "../../styles/blog.css";

/**
 * @description ブログ記事一覧ページ（2ページ目以降）
 * - /blog/2/, /blog/3/ ... のルートを静的生成する
 */

export const getStaticPaths = (async () => {
  const postsPerPage = 10;
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = allPosts.sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );

  const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
  const paths = [];

  // 2ページ目以降のみ生成（1ページ目は index.astro が担当）
  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * postsPerPage;
    const pagePosts = sortedPosts.slice(start, start + postsPerPage);
    paths.push({
      params: { page: String(page) },
      props: { posts: pagePosts, currentPage: page, totalPages }
    });
  }

  return paths;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`ブログ — ${currentPage}ページ目 — Anemonet`}
  description="Anemonet のブログ。AI駆動開発、システム設計、技術トピックなどを発信します。"
>
  <Header currentPath="/blog/" />

  <main class="site-main" id="main-content">
    <div class="blog-page">
      <div class="container">
        <header class="blog-page-header">
          <h1 class="blog-page-title">Blog</h1>
          <p class="blog-page-lead">
            AI駆動開発、システム設計、技術トピックなどを発信します。
          </p>
        </header>

        <div class="blog-list">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              slug={post.id}
            />
          ))}
        </div>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl="/blog"
        />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
